{
  "name": "modelfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:e2e": "cross-env ASTRO_TELEMETRY_DISABLED=1 node scripts/preview-e2e.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:rules": "npx -y firebase-tools@15.28.1 emulators:exec --only firestore --project demo-modelfit-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npm run build && playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=desktop-chromium",
    "test:performance": "playwright test e2e/performance.spec.ts --project=desktop-chromium",
    "check:env": "tsx scripts/check-env.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:models-csv": "tsx scripts/import-models-csv.ts --check",
    "import:models": "tsx scripts/import-models-csv.ts",
    "database:seed": "tsx scripts/generate-dataconnect-seed.ts",
    "database:check": "npm run database:seed && prettier --check \"dataconnect/**/*.{gql,yaml}\" && tsx scripts/check-dataconnect.ts",
    "database:compile": "npx -y firebase-tools@15.28.1 dataconnect:compile",
    "database:sdk": "npx -y firebase-tools@15.28.1 dataconnect:sdk:generate",
    "database:emulator": "npx -y firebase-tools@15.28.1 emulators:start --only dataconnect",
    "audit:sources": "tsx scripts/audit-sources.ts",
    "audit:freshness": "tsx scripts/audit-freshness.ts",
    "sync:model-images": "tsx scripts/sync-model-images.ts",
    "check": "npm run format && npm run lint && npm run check:env && npm run validate:data && npm run check:models-csv && npm run catalog:check && npm run database:check && npm run test && npm run test:rules && npm run build",
    "catalog:export": "tsx scripts/export-relational-csv.ts",
    "catalog:check": "tsx scripts/check-relational-csv.ts && tsx scripts/import-relational-csv.ts --check",
    "catalog:import": "tsx scripts/import-relational-csv.ts && npm run import:models"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "firebase": "^12.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/parser": "^8.67.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
