PUBLIC_SITE_URL=https://example.com
PUBLIC_SITE_NAME=모델핏
# 비어 있으면 기존 공개 운영 이메일을 사용합니다.
PUBLIC_REPORT_EMAIL=
PUBLIC_AFFILIATE_DISCLOSURE_TEXT=
PUBLIC_GA_MEASUREMENT_ID=
# Firebase 웹 설정은 브라우저에 공개되는 식별자이며 비밀번호나 서비스 계정 키가 아닙니다.
# 실제 접근 권한은 Firestore 보안 규칙과 App Check에서 통제합니다.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# 공개 제보 접수를 활성화하기 전에 Firebase App Check의 reCAPTCHA Enterprise 키를 설정하세요.
PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# 기본값은 CSV 기반 정적 카탈로그입니다. SQL Connect 전환 준비가 끝난 뒤에만 변경합니다.
PUBLIC_CATALOG_DATA_SOURCE=csv
# 로컬 SQL Connect 에뮬레이터를 브라우저에서 사용할 때만 지정합니다. 예: 127.0.0.1:9399
PUBLIC_DATA_CONNECT_EMULATOR_HOST=

# 서버/빌드 전용 쿠팡 파트너스 키. PUBLIC_ 접두사를 붙이지 마세요.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
