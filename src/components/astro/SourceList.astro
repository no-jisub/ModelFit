---
import type { SourceReference } from "@/types";

const { sources } = Astro.props as { sources: SourceReference[] };
const sourceTypeLabels: Record<SourceReference["sourceType"], string> = {
  manufacturer: "제조사",
  "official-manual": "공식 매뉴얼",
  "official-store": "공식몰",
  seller: "판매처",
  other: "기타",
};
const sourcePriority: Record<SourceReference["sourceType"], number> = {
  manufacturer: 0,
  "official-manual": 1,
  "official-store": 2,
  seller: 3,
  other: 4,
};
const orderedSources = [...sources].sort(
  (left, right) => sourcePriority[left.sourceType] - sourcePriority[right.sourceType],
);
---

<section class="source-list" aria-labelledby="source-title">
  <h3 id="source-title">확인 출처</h3>
  {
    sources.length > 0 ? (
      <ul>
        {orderedSources.map((source) => (
          <li>
            <span class={`source-type is-${source.sourceType}`}>
              {sourceTypeLabels[source.sourceType]}
            </span>
            <a
              href={source.url}
              rel="noopener noreferrer"
              target="_blank"
              data-source-type={source.sourceType}
            >
              {source.title}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-inline">
        <span aria-hidden="true">!</span>
        <p>
          <strong>등록된 공식 출처가 없습니다.</strong> 이 데이터는 미검증 데모이며 구매 판단에
          사용할 수 없습니다.
        </p>
      </div>
    )
  }
</section>
