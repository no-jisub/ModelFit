---
interface Item {
  label: string;
  href?: string;
}

const { items } = Astro.props as { items: Item[] };
---

<nav class="breadcrumbs" aria-label="현재 위치">
  <ol>
    <li><a href="/">홈</a></li>
    {
      items.map((item, index) => (
        <li aria-current={index === items.length - 1 ? "page" : undefined}>
          {item.href && index !== items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            item.label
          )}
        </li>
      ))
    }
  </ol>
</nav>
