---
import type { ConsumableCompatibility, PurchaseChannel } from "@/types";
import { getPurchaseLinks } from "@/utils/purchaseLinks";

const { part } = Astro.props as { part: ConsumableCompatibility };
const configuredCoupangBaseUrl = import.meta.env.PUBLIC_COUPANG_BASE_URL?.trim();
const links = getPurchaseLinks(part, configuredCoupangBaseUrl);
const channels: Array<{
  id: PurchaseChannel;
  label: string;
  note: string;
}> = [
  {
    id: "official",
    label: "공식 사이트",
    note: "판매 페이지가 아니면 호환 근거와 부품번호를 먼저 확인하세요.",
  },
  {
    id: "coupang",
    label: "쿠팡",
    note: "일반 링크이며 상품명만으로 정품이나 호환 여부를 단정하지 않습니다.",
  },
  {
    id: "other",
    label: "기타 판매처",
    note: "판매자 고지, 교환 조건과 적용 모델을 다시 확인하세요.",
  },
];
---

<div class="purchase-link-list">
  {
    channels.map((channel, index) => {
      const channelLinks = links.filter((link) => link.channel === channel.id);
      if (channelLinks.length === 0) return null;
      const channelNote =
        channel.id === "coupang" && part.affiliate.restrictionNote
          ? `${part.affiliate.restrictionNote}으로 일반 상품 링크만 제공합니다.`
          : channel.id === "coupang" && channelLinks.some((link) => link.isAffiliate)
            ? "쿠팡 파트너스 제휴 링크이며 상품명만으로 정품이나 호환 여부를 단정하지 않습니다."
            : channel.note;

      return (
        <section
          class={`purchase-channel is-${channel.id}`}
          aria-labelledby={`${part.id}-${channel.id}`}
        >
          <span class="purchase-channel-label" id={`${part.id}-${channel.id}`}>
            <b>{index + 1}</b> {channel.label}
          </span>
          {channelLinks.map((link) => (
            <a
              class={`button ${channel.id === "official" ? "button-primary" : "button-secondary"}`}
              href={link.url}
              rel={
                link.isAffiliate
                  ? "nofollow sponsored noopener noreferrer"
                  : channel.id === "official"
                    ? "noopener noreferrer"
                    : "nofollow noopener noreferrer"
              }
              target="_blank"
              data-purchase-channel={link.channel}
              data-part-id={part.id}
              data-link-status={link.linkType}
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
          <p class="part-action-copy">{channelNote}</p>
          <small>링크 확인 {channelLinks[0]?.checkedAt}</small>
        </section>
      );
    })
  }
</div>
