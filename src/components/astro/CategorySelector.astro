---
const cards = [
  {
    slug: "air-purifier",
    title: "공기청정기",
    image: "/images/categories/air-purifier.webp",
  },
  {
    slug: "robot-vacuum",
    title: "로봇청소기",
    image: "/images/categories/robot-vacuum.webp",
  },
];
---

<div class="category-selector-shell">
  <p class="category-selector-title">찾고 싶은 제품을 선택해 보세요</p>
  <div class="category-grid">
    {
      cards.map((card) => (
        <a class="category-card" href={`/category/${card.slug}`}>
          <span class="category-visual">
            <img src={card.image} width="512" height="512" alt="" loading="eager" />
          </span>
          <strong>{card.title}</strong>
        </a>
      ))
    }
    <a class="category-card category-card-all" href="/find">
      <span class="category-visual" aria-hidden="true"><span>+</span></span>
      <strong>전체보기</strong>
    </a>
  </div>
</div>
