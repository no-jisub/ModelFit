---
import { brands } from "@/data/brands";
import { models } from "@/data/models";
import type { ApplianceCategory } from "@/types";

const getStats = (category: ApplianceCategory) => {
  const modelCount = models.filter((model) => model.category === category && !model.isDemo).length;
  const brandCount = brands.filter((brand) => brand.supportedCategories.includes(category)).length;
  return `${modelCount}개 공식 모델 · ${brandCount}개 브랜드`;
};

const cards = [
  {
    slug: "air-purifier",
    icon: "▤",
    title: "공기청정기",
    description: "집진 · HEPA · 탈취 · 프리필터",
    stats: getStats("air-purifier"),
  },
  {
    slug: "robot-vacuum",
    icon: "◉",
    title: "로봇청소기",
    description: "필터 · 먼지봉투 · 브러시 · 물걸레",
    stats: getStats("robot-vacuum"),
  },
];
---

<div class="category-grid">
  {
    cards.map((card) => (
      <a class="category-card card interactive-card" href={`/category/${card.slug}`}>
        <span class="category-icon" aria-hidden="true">
          {card.icon}
        </span>
        <span>
          <strong>{card.title}</strong>
          <small>{card.description}</small>
          <span>{card.stats}</span>
        </span>
        <span class="card-arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))
  }
</div>
