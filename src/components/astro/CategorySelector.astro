---
import { categories } from "@/data/categories";
---

<div class="category-selector-shell">
  <p class="category-selector-title">찾고 싶은 제품을 선택해 보세요</p>
  <div class="category-grid">
    {
      categories.map((category) => (
        <a class="category-card" href={`/category/${category.id}`}>
          <span class="category-visual">
            <img src={category.selectorImage} width="512" height="512" alt="" loading="eager" />
          </span>
          <strong>{category.label}</strong>
        </a>
      ))
    }
    <a class="category-card category-card-all" href="/find">
      <span class="category-visual" aria-hidden="true"><span>+</span></span>
      <strong>전체보기</strong>
    </a>
  </div>
</div>
