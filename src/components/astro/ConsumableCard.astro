---
import type { ConsumableCompatibility } from "@/types";
import { partNumberStatusLabels, partTypeLabels } from "@/utils/labels";
import { getMaintenancePresentation, getPartConfiguration } from "@/utils/partPresentation";
import ProductOptionCard from "./ProductOptionCard.astro";
import VerificationBadge from "./VerificationBadge.astro";

const { part, modelCode, modelId } = Astro.props as {
  part: ConsumableCompatibility;
  modelCode: string;
  modelId: string;
};
const typeDescriptions = {
  "dust-filter": "공기 중 먼지를 포집하는 교체 필터입니다.",
  "hepa-filter": "공기 중 미세입자와 초미세먼지를 포집하는 필터입니다.",
  "deodorizing-filter": "생활 냄새와 가스 성분을 흡착하는 필터입니다.",
  "custom-filter": "사용 환경에 맞춰 선택하는 필터입니다. 종류와 적용 모델을 확인하세요.",
  "pre-filter": "큰 먼지와 털을 먼저 걸러 주는 전처리 필터입니다.",
  "all-in-one-filter": "여러 필터 기능을 하나의 구성으로 합친 필터입니다.",
  "dust-bin-filter": "먼지통으로 들어온 미세먼지가 다시 배출되지 않도록 걸러 줍니다.",
  "dust-bag": "수거된 먼지를 보관하는 먼지봉투입니다.",
  "main-brush": "바닥의 먼지와 이물질을 쓸어 흡입구로 보내는 메인 브러시입니다.",
  "side-brush": "벽면과 모서리의 먼지를 중앙 흡입구 쪽으로 모아 줍니다.",
  "mop-pad": "바닥 물걸레 청소에 사용하는 패드입니다.",
} as const;
const configuration = getPartConfiguration(part, modelId);
const compatibility = part.compatibilities.find((relation) => relation.modelId === modelId);
const compatibilityStatus = compatibility?.verificationStatus ?? "unverified";
const maintenance = getMaintenancePresentation(part);
const compatibilityNotes = {
  official: "제조사 자료에서 이 모델과의 호환 관계를 확인했습니다.",
  "seller-confirmed": "판매자가 이 모델과 호환된다고 표시한 정보입니다.",
  "user-reported": "사용자 제보로 확인된 정보이며 공식 자료 확인이 필요합니다.",
  unverified: "구매 판단에 필요한 호환 근거가 아직 확인되지 않았습니다.",
} as const;
const evidenceSources =
  compatibility?.evidenceScope === "scoped" ? compatibility.sources : part.sources;
const evidenceCount = evidenceSources.length;
---

<article class="consumable-group card" id={part.id}>
  <header class:list={["consumable-group-heading", part.image && "has-part-image"]}>
    {
      part.image && (
        <figure class="part-image">
          <img src={part.image.src} alt={part.image.alt} width="240" height="240" loading="lazy" />
          <figcaption>
            <a href={part.image.sourceUrl} target="_blank" rel="noopener noreferrer">
              부품 이미지 출처
            </a>
            <span> · 이미지 확인: {part.image.checkedAt}</span>
          </figcaption>
        </figure>
      )
    }
    <div>
      <div class="eyebrow">{partTypeLabels[part.type]}</div>
      <h3>{part.displayName}</h3>
      <p>{typeDescriptions[part.type]}</p>
    </div>
  </header>

  <div class="part-decision-grid">
    <section class="part-number-panel" aria-label="부품번호">
      <span class="part-field-label">정확한 부품번호</span>
      {
        part.genuinePartNumber ? (
          <div class="part-number-value">
            <code>{part.genuinePartNumber}</code>
            <button
              type="button"
              class="copy-part-number"
              data-copy-value={part.genuinePartNumber}
              aria-label={`${part.genuinePartNumber} 부품번호 복사`}
            >
              <span data-copy-label>복사</span>
            </button>
          </div>
        ) : (
          <strong>{partNumberStatusLabels[part.partNumberStatus]}</strong>
        )
      }
    </section>

    <section class="part-compatibility-panel" aria-label={`${modelCode} 호환 상태`}>
      <div>
        <span class="part-field-label">{modelCode} 호환 상태</span>
        <VerificationBadge status={compatibilityStatus} context="compatibility" />
      </div>
      <p>
        {
          compatibility?.evidenceScope === "legacy-unscoped"
            ? "이 모델의 호환 근거를 재확인하고 있습니다. 구매 전 제조사 안내를 확인하세요."
            : compatibilityNotes[compatibilityStatus]
        }
      </p>
    </section>
  </div>

  {
    (configuration || maintenance) && (
      <dl class="part-use-details">
        {configuration?.itemCode && (
          <div>
            <dt>상품·구성 코드</dt>
            <dd>{configuration.itemCode}</dd>
          </div>
        )}
        {configuration?.requiredQuantity && (
          <div class="is-required-quantity">
            <dt>제품 1대 필요 수량</dt>
            <dd>{configuration.requiredQuantity}</dd>
          </div>
        )}
        {configuration?.salesPackage && (
          <div>
            <dt>판매 단위</dt>
            <dd>{configuration.salesPackage}</dd>
          </div>
        )}
        {configuration?.composition && (
          <div>
            <dt>확인된 구성 정보</dt>
            <dd>{configuration.composition}</dd>
          </div>
        )}
        {maintenance && (
          <div class="part-maintenance-detail">
            <dt>관리 방식</dt>
            <dd>
              <span class="maintenance-badge">{maintenance.mode}</span>
              <span>{maintenance.detail}</span>
            </dd>
          </div>
        )}
      </dl>
    )
  }

  <section class="product-options-section" aria-labelledby={part.id + "-products"}>
    <div class="product-options-heading">
      <h4 id={part.id + "-products"}>구매처와 교체·관리 안내</h4>
      <p>판매 상품의 구성과 적용 모델을 다시 확인한 뒤 구매하세요.</p>
    </div>

    <div class="product-option-list">
      {
        part.productOptions.length > 0 ? (
          part.productOptions.map((option) => (
            <ProductOptionCard
              option={option}
              modelId={modelId}
              partId={part.id}
              fallbackPartNumber={part.genuinePartNumber}
              showPackageLabel={part.productOptions.length > 1}
            />
          ))
        ) : (
          <p class="purchase-unavailable">
            <strong>확인된 구매처가 없습니다.</strong>
            {part.genuinePartNumber
              ? ` 부품번호 ${part.genuinePartNumber}로 제조사나 판매처에 문의하세요.`
              : " 제조사 안내에서 부품명과 적용 모델을 다시 확인하세요."}
          </p>
        )
      }
    </div>
    {
      part.purchaseWarning && (
        <details class="part-care-warning">
          <summary>관리 및 구매 전 주의사항</summary>
          <p>{part.purchaseWarning}</p>
        </details>
      )
    }
  </section>

  <details class="part-evidence">
    <summary>
      <span>확인 근거와 날짜</span>
      <small>{evidenceCount > 0 ? `${evidenceCount}건` : "근거 미확인"}</small>
    </summary>
    <div class="part-evidence-content">
      {
        evidenceCount > 0 ? (
          <ul>
            {evidenceSources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.title}
                </a>
                <span>
                  자료 확인: <time datetime={source.checkedAt}>{source.checkedAt}</time>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p>이 부품의 호환 근거가 아직 연결되지 않았습니다. 구매 전 제조사에 확인하세요.</p>
        )
      }
    </div>
  </details>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue;
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      if (!value || !label) return;

      try {
        await navigator.clipboard.writeText(value);
        label.textContent = "복사됨";
        window.setTimeout(() => (label.textContent = "복사"), 1600);
      } catch {
        label.textContent = "복사 실패";
        window.setTimeout(() => (label.textContent = "복사"), 1600);
      }
    });
  });
</script>
