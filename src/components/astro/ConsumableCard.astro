---
import type { ConsumableCompatibility } from "@/types";
import { partTypeLabels } from "@/utils/labels";
import AffiliateButton from "./AffiliateButton.astro";
import PartNumberBadge from "./PartNumberBadge.astro";
import VerificationBadge from "./VerificationBadge.astro";

const { part } = Astro.props as { part: ConsumableCompatibility };
const officialSource =
  part.sources.find((source) => source.sourceType === "official-store") ?? part.sources[0];
---

<article class="consumable-card card">
  <div class="consumable-info">
    <div class="eyebrow">{partTypeLabels[part.type]}</div>
    <h3>{part.displayName}</h3>
    <dl class="detail-list">
      <div><dt>정품 부품번호</dt><dd>{part.genuinePartNumber ?? "정보 없음"}</dd></div>
      <div><dt>교체주기 참고</dt><dd>{part.replacementInterval ?? "제조사 안내 확인"}</dd></div>
      <div>
        <dt>검증 상태</dt><dd>
          <VerificationBadge status={part.verificationStatus} context="compatibility" />
        </dd>
      </div>
      <div>
        <dt>부품번호 상태</dt><dd>
          <PartNumberBadge partNumber={part.genuinePartNumber} status={part.partNumberStatus} />
        </dd>
      </div>
    </dl>
  </div>
  <div class="consumable-actions">
    <AffiliateButton
      keyword={part.affiliate.searchKeyword}
      kind="genuine"
      partId={part.id}
      directUrl={part.affiliate.directUrl}
      affiliateLink={part.affiliate.isAffiliate}
      restrictionNote={part.affiliate.restrictionNote}
      enabled={part.affiliate.enabled}
      linkStatus={part.affiliate.status}
      priceStatus={part.affiliate.priceStatus}
      stockStatus={part.affiliate.stockStatus}
      linkCheckedAt={part.affiliate.linkCheckedAt}
    />
    {
      officialSource && (
        <a
          class="button button-secondary official-source-button"
          href={officialSource.url}
          rel="noopener noreferrer"
          target="_blank"
          data-source-type={officialSource.sourceType}
          data-part-id={part.id}
        >
          제조사 호환 근거 보기 <span aria-hidden="true">↗</span>
        </a>
      )
    }
    <p class="purchase-warning-inline">구매 전 확인: {part.purchaseWarning}</p>
  </div>
</article>
