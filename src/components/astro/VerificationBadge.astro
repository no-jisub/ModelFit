---
import type { VerificationStatus } from "@/types";
import { getVerificationLabel, type VerificationContext } from "@/utils/labels";

interface Props {
  status: VerificationStatus;
  context?: VerificationContext;
}

const { status, context = "source" } = Astro.props;
const label = getVerificationLabel(status, context);
const icons: Record<VerificationStatus, string> = {
  official: "✓",
  "seller-confirmed": "▣",
  "user-reported": "●",
  unverified: "!",
};
---

<span class:list={["status-badge", `status-${status}`]} title={`${label} 상태`}>
  <span aria-hidden="true">{icons[status]}</span>
  {label}
</span>
