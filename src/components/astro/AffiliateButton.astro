---
import { buildAffiliateUrl } from "@/utils/affiliate";
import AffiliateDisclosure from "./AffiliateDisclosure.astro";

const {
  keyword,
  kind = "genuine",
  partId,
  directUrl,
  affiliateLink = false,
  enabled = false,
  linkStatus,
} = Astro.props as {
  keyword: string;
  kind?: "genuine" | "compatible";
  partId: string;
  directUrl?: string;
  affiliateLink?: boolean;
  enabled?: boolean;
  linkStatus?: "direct-product" | "search-results" | "unavailable";
};
const configuredBaseUrl = import.meta.env.PUBLIC_COUPANG_BASE_URL?.trim();
const query = kind === "genuine" ? `${keyword} 정품` : `${keyword} 호환`;
const marketplaceUrl =
  kind === "genuine" && enabled && linkStatus !== "unavailable" ? directUrl : undefined;
const affiliateUrl = buildAffiliateUrl(configuredBaseUrl, query);
const url = marketplaceUrl ?? (kind === "compatible" ? affiliateUrl : null);
const isAffiliate = marketplaceUrl
  ? affiliateLink
  : Boolean(configuredBaseUrl) && Boolean(affiliateUrl);
const label =
  kind === "genuine"
    ? linkStatus === "direct-product"
      ? "쿠팡 상품 보기"
      : linkStatus === "search-results"
        ? "쿠팡 검색 결과 보기"
        : "쿠팡 상품 링크 준비 중"
    : "쿠팡에서 호환 후보 검색";
---

<div class="affiliate-link-stack">
  {
    url ? (
      <a
        class="button button-primary affiliate-button"
        href={url}
        rel={
          isAffiliate ? "nofollow sponsored noopener noreferrer" : "nofollow noopener noreferrer"
        }
        target="_blank"
        data-affiliate-kind={kind}
        data-purchase-channel="coupang"
        data-part-id={partId}
        data-link-status={linkStatus}
      >
        {label} <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span
        class="button button-primary affiliate-button is-disabled"
        aria-disabled="true"
        title="확인된 쿠팡 링크가 없습니다."
      >
        {label}
      </span>
    )
  }
  {isAffiliate && <AffiliateDisclosure hasAffiliateLinks={true} />}
</div>
