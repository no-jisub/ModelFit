---
import { buildAffiliateUrl } from "@/utils/affiliate";

const {
  keyword,
  kind = "genuine",
  partId,
  directUrl,
  enabled = false,
  linkStatus,
  priceStatus,
  stockStatus,
  linkCheckedAt,
} = Astro.props as {
  keyword: string;
  kind?: "genuine" | "compatible";
  partId: string;
  directUrl?: string;
  enabled?: boolean;
  linkStatus?: "direct-product" | "search-results" | "unavailable";
  priceStatus?: "manual-check-required" | "recently-checked";
  stockStatus?: "manual-check-required" | "in-stock" | "out-of-stock";
  linkCheckedAt?: string;
};
const baseUrl = import.meta.env.PUBLIC_COUPANG_BASE_URL;
const query = kind === "genuine" ? `${keyword} 정품` : `${keyword} 호환`;
const marketplaceUrl =
  kind === "genuine" && enabled && linkStatus !== "unavailable" ? directUrl : undefined;
const affiliateUrl = buildAffiliateUrl(baseUrl, query);
const url = marketplaceUrl ?? affiliateUrl;
const isAffiliate = !marketplaceUrl && Boolean(affiliateUrl);
const label =
  kind === "genuine"
    ? linkStatus === "direct-product"
      ? "쿠팡 상품 바로가기"
      : linkStatus === "search-results"
        ? "쿠팡 검색 결과 보기"
        : "쿠팡 판매 확인 안 됨"
    : "쿠팡에서 호환품 검색";
const statusLabel =
  kind === "genuine"
    ? linkStatus === "direct-product"
      ? "직접 상품 링크 · 판매자 확인 필요"
      : linkStatus === "search-results"
        ? "검색 링크 · 정품 여부 확인 필요"
        : "등록된 쿠팡 링크 없음"
    : undefined;
const statusClass =
  linkStatus === "direct-product"
    ? "coupang-status-direct"
    : linkStatus === "search-results"
      ? "coupang-status-search"
      : "coupang-status-unavailable";
const priceLabel =
  priceStatus === "recently-checked" ? "가격: 최근 수동 확인" : "가격: 판매 페이지에서 확인";
const stockLabel =
  stockStatus === "in-stock"
    ? "재고: 확인 당시 판매 중"
    : stockStatus === "out-of-stock"
      ? "재고: 확인 당시 품절"
      : "재고: 수동 확인 필요";
---

<div class="affiliate-link-stack">
  {
    url ? (
      <a
        class="button button-secondary affiliate-button"
        href={url}
        rel={
          isAffiliate ? "nofollow sponsored noopener noreferrer" : "nofollow noopener noreferrer"
        }
        target="_blank"
        data-affiliate-kind={kind}
        data-purchase-channel="coupang"
        data-part-id={partId}
        data-link-status={linkStatus}
      >
        {label} <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span
        class="button button-secondary affiliate-button is-disabled"
        aria-disabled="true"
        title="확인된 쿠팡 링크가 없습니다."
      >
        {label}
      </span>
    )
  }
  {statusLabel && <span class={`coupang-link-status ${statusClass}`}>{statusLabel}</span>}
  <div class="commerce-status" aria-label="가격과 재고 확인 상태">
    <span>{priceLabel}</span>
    <span>{stockLabel}</span>
    {linkCheckedAt && <small>링크 확인 {linkCheckedAt}</small>}
  </div>
</div>
