---
import type { Brand } from "@/types";
import { models } from "@/data/models";
import { categoryLabels } from "@/utils/labels";

const { brand } = Astro.props as { brand: Brand };
const brandModels = models.filter((model) => model.brandId === brand.id);
const officialCount = brandModels.filter((model) => !model.isDemo).length;
---

<a class="brand-card card interactive-card" href={`/brand/${brand.slug}`}>
  <span class="brand-initial" aria-hidden="true">{brand.nameEn?.[0] ?? brand.name[0]}</span>
  <span>
    <strong>{brand.name}</strong>
    <small>{brand.nameEn}</small>
  </span>
  <span class="brand-meta">
    {brand.supportedCategories.map((category) => categoryLabels[category]).join(" · ")}
    <br />
    {officialCount}개 공식 모델
  </span>
</a>
