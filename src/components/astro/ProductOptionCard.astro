---
import type { ConsumableProductOption } from "@/types";
import AffiliateDisclosure from "./AffiliateDisclosure.astro";
import PurchasePrice from "./PurchasePrice.astro";
import { getFilterSelectionGuide } from "@/utils/filterSelectionGuide";

const {
  option,
  compatibilityConfirmed = false,
  modelId,
  partName,
  partId,
  fallbackPartNumber,
  showPackageLabel = true,
  requiredQuantity,
  packageLabel: presentedPackageLabel,
  layout = "card",
  showDisclosure = true,
  partNumber,
} = Astro.props as {
  option: ConsumableProductOption;
  compatibilityConfirmed?: boolean;
  modelId: string;
  partName: string;
  partId: string;
  fallbackPartNumber?: string;
  showPackageLabel?: boolean;
  requiredQuantity?: string;
  packageLabel?: string;
  layout?: "card" | "row";
  showDisclosure?: boolean;
  partNumber?: string;
};
const headingId = option.id + "-heading";
const kindLabel = option.kind === "genuine" ? "정품" : "호환상품";
const verificationLabels = {
  "official-genuine": "공식 규격·호환 근거 확인",
  "verified-compatible": "호환 근거 확인",
  unverified: "미검증",
} as const;
const productVerificationLabel =
  option.verification === "seller-claimed"
    ? option.kind === "genuine"
      ? "판매자 정품 표기"
      : "판매자 호환 표기"
    : verificationLabels[option.verification];
const verificationLabel =
  !compatibilityConfirmed &&
  ["official-genuine", "verified-compatible"].includes(option.verification)
    ? "상품 자료 확인 · 모델 호환 확인 필요"
    : productVerificationLabel;
const packageLabel = presentedPackageLabel ?? option.modelLabels[modelId] ?? option.packageLabel;
const packageNeedsReview = !packageLabel || /확인 필요|구매처에서 확인/.test(packageLabel);
const purchaseLinks = option.purchaseLinks;
const guidanceLinks = option.guidanceLinks;
const searchablePartNumber = option.itemCode ?? fallbackPartNumber;
const isOverseas = (url: string) => new URL(url).hostname === "www.eufy.com";
const selectionGuide = getFilterSelectionGuide(partId, option.itemCode ?? partNumber);
---

<article
  class:list={[
    "product-option-card",
    option.kind === "genuine" ? "is-genuine" : "is-compatible",
    layout === "row" && "product-option-row",
  ]}
  aria-labelledby={headingId}
>
  <div class="product-option-heading">
    <div>
      <div class="product-option-badges">
        <span class:list={["product-kind-badge", "is-" + option.kind]}>{kindLabel}</span>
        <span
          class:list={[
            "product-verification-badge",
            compatibilityConfirmed && option.verification === "official-genuine" && "sr-only",
          ]}>{verificationLabel}</span
        >
      </div>
      <h5 id={headingId} class:list={[layout !== "row" && option.name === partName && "sr-only"]}>
        {option.name}
      </h5>
      {
        selectionGuide && (
          <dl class="product-selection-guide">
            <div>
              <>
                <dt>탈취 성능</dt>
                <dd>{selectionGuide.deodorization}</dd>
              </>
            </div>
            <div>
              <>
                <dt>추천 환경</dt>
                <dd>{selectionGuide.environment}</dd>
              </>
            </div>
            <div>
              <>
                <dt>교체 주기</dt>
                <dd>{selectionGuide.replacement}</dd>
              </>
            </div>
          </dl>
        )
      }
      {
        partNumber && (
          <div class="part-number-inline" aria-label="상품 부품번호">
            <>
              <span>부품번호</span>
              <code>{partNumber}</code>
            </>
            <button
              type="button"
              class="copy-part-number"
              data-copy-value={partNumber}
              aria-label={`${partNumber} 부품번호 복사`}
            >
              <span data-copy-label>복사</span>
            </button>
          </div>
        )
      }
    </div>
  </div>

  {
    showPackageLabel && (
      <dl class="product-option-details">
        {requiredQuantity && (
          <div>
            <dt>제품 1대 필요 수량</dt>
            <dd>{requiredQuantity}</dd>
          </div>
        )}
        <div>
          <dt>판매 구성</dt>
          <dd class:list={[packageNeedsReview && "package-needs-review"]}>
            {packageLabel ?? "수량은 구매처에서 확인"}
          </dd>
        </div>
      </dl>
    )
  }

  <div class="product-option-links">
    {
      purchaseLinks.map((link, index) => (
        <Fragment>
          <PurchasePrice link={link} />
          <a
            class:list={[
              "button",
              link.channel === "official" ? "button-secondary" : "button-primary",
            ]}
            id={`${partId}--${option.id}--purchase-${index}`}
            href={link.url}
            rel={
              link.isAffiliate
                ? "nofollow sponsored noopener noreferrer"
                : link.channel === "official"
                  ? "noopener noreferrer"
                  : "nofollow noopener noreferrer"
            }
            target="_blank"
            data-product-option-id={option.id}
            data-product-kind={option.kind}
            data-purchase-channel={link.channel}
            data-part-id={partId}
            data-link-status={link.linkType}
          >
            {link.channel === "coupang"
              ? "쿠팡에서 구매하기"
              : link.channel === "official"
                ? isOverseas(link.url)
                  ? "해외 공식몰에서 구매하기"
                  : "공식몰에서 구매하기"
                : link.label}{" "}
            <span aria-hidden="true">↗</span>
          </a>
          {showDisclosure && link.channel === "coupang" && (
            <AffiliateDisclosure hasAffiliateLinks={link.isAffiliate} />
          )}
          {link.channel === "official" && isOverseas(link.url) && (
            <p class="purchase-unavailable">
              해외 공식몰 상품입니다. 국내 배송 가능 여부를 확인하세요.
            </p>
          )}
        </Fragment>
      ))
    }
    {
      purchaseLinks.length === 0 && (
        <p class="purchase-unavailable">
          <strong>확인된 구매처가 없습니다.</strong>
          {searchablePartNumber
            ? ` 부품번호 ${searchablePartNumber}로 제조사나 판매처에 문의하세요.`
            : " 제조사 안내에서 부품명과 적용 모델을 다시 확인하세요."}
        </p>
      )
    }
  </div>
  {
    purchaseLinks.length === 0 && (
      <>
        <>
          <p>{option.description}</p>
          <div class="product-guidance-links">
            {guidanceLinks.map((link) => (
              <a
                href={link.url}
                rel="noopener noreferrer"
                target="_blank"
                data-product-option-id={option.id}
                data-product-kind={option.kind}
                data-purchase-channel={link.channel}
                data-part-id={partId}
                data-link-status={link.linkType}
              >
                {!compatibilityConfirmed && link.label.includes("공식 호환")
                  ? "제조사 참고 자료"
                  : link.label}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </>
      </>
    )
  }
</article>
