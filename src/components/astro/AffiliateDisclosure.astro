---
const { hasAffiliateLinks = false } = Astro.props as { hasAffiliateLinks?: boolean };
const requiredDisclosure =
  "이 포스팅은 쿠팡 파트너스 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받습니다.";
const affiliateActive = hasAffiliateLinks;
const nonAffiliateText = "일반 상품 링크이며 모델핏은 수수료를 받지 않습니다.";
const text = affiliateActive
  ? requiredDisclosure
  : import.meta.env.PUBLIC_AFFILIATE_DISCLOSURE_TEXT?.trim() || nonAffiliateText;
---

<p class="affiliate-disclosure"><span aria-hidden="true">ⓘ</span> {text}</p>
