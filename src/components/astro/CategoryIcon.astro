---
import type { ApplianceCategory } from "@/types";

const { category } = Astro.props as { category: ApplianceCategory };
---

{
  category === "air-purifier" ? (
    <svg class="category-symbol" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="5" y="2" width="14" height="20" rx="3" />
      <path d="M8 7h8M8 11h8M8 15h8M9 19h6" />
    </svg>
  ) : (
    <svg class="category-symbol" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M9 4.2V7h6V4.2M7.5 16.5c2.8 1.5 6.2 1.5 9 0" />
      <circle cx="12" cy="11" r="1.3" />
    </svg>
  )
}
