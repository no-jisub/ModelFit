---
import AffiliateDisclosure from "@/components/astro/AffiliateDisclosure.astro";
import BrandCard from "@/components/astro/BrandCard.astro";
import CategorySelector from "@/components/astro/CategorySelector.astro";
import ModelCard from "@/components/astro/ModelCard.astro";
import SearchBox from "@/components/react/SearchBox";
import { brands } from "@/data/brands";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";

const popularModels = [
  "samsung-ap90h10198edd",
  "lg-as355nsna",
  "roborock-saros-z70",
  "dreame-x50s-pro-ultra",
]
  .map((id) => models.find((model) => model.id === id))
  .filter((model) => model !== undefined);
const recentModels = models.slice(-4).reverse();
const websiteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "모델핏",
    url: Astro.site,
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site}find?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "모델핏",
    url: Astro.site,
  },
];
---

<BaseLayout
  title="가전 모델명으로 호환 소모품 찾기"
  description="공기청정기와 로봇청소기 모델명을 검색해 필터, 브러시, 먼지봉투 등 호환 소모품 정보를 확인하세요."
  canonicalPath="/"
  jsonLd={websiteJsonLd}
>
  <div class="demo-banner">
    모델 정보는 제조사 공식 출처 기반 · 소모품 호환은 검증된 항목만 별도 표시
  </div>
  <section class="hero">
    <div class="container hero-inner">
      <span class="trust-pill"><span aria-hidden="true">✓</span> 구매 전 호환성 확인 도구</span>
      <h1>가전 모델명만 입력하면<br />맞는 소모품을 찾을 수 있어요</h1>
      <p class="hero-description">
        정품 부품번호, 호환 범위, 검증 상태와 마지막 확인일을<br />
        한눈에 비교할 수 있도록 정리합니다.
      </p>
      <SearchBox client:load />
      <div class="quick-categories" aria-label="카테고리 빠른 선택">
        <a href="/category/air-purifier"><span aria-hidden="true">▤</span> 공기청정기</a>
        <a href="/category/robot-vacuum"><span aria-hidden="true">◉</span> 로봇청소기</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">지원 카테고리</div>
          <h2>어떤 제품을 찾고 계신가요?</h2>
          <p>첫 MVP에서는 두 가지 가전 카테고리를 지원합니다.</p>
        </div>
      </div>
      <CategorySelector />
    </div>
  </section>

  <section class="section" id="brands">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">인기 브랜드</div>
          <h2>브랜드별로 모델 찾기</h2>
          <p>제조사 로고 대신 중립적인 이니셜로 구분합니다.</p>
        </div>
        <a class="text-link" href="/find">전체 모델 보기 →</a>
      </div>
      <div class="brand-grid">
        {brands.map((brand) => <BrandCard brand={brand} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">많이 찾는 모델</div>
          <h2>대표 공식 모델</h2>
          <p>17개 브랜드의 제조사 공식 제품·지원 자료에서 확인한 모델입니다.</p>
        </div>
      </div>
      <div class="model-grid">
        {popularModels.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">모델명 찾기</div>
          <h2>정확한 모델 코드를 입력하세요</h2>
          <p>제품군 이름보다 영문과 숫자가 포함된 모델 코드가 정확합니다.</p>
        </div>
        <a class="text-link" href="/guide/find-model-number">자세한 가이드 →</a>
      </div>
      <div class="info-steps">
        <article class="step-card card">
          <h3>정격 라벨 확인</h3>
          <p>제품 뒷면, 바닥면 또는 필터 덮개 안쪽의 라벨을 찾습니다.</p>
        </article>
        <article class="step-card card">
          <h3>모델명 구분</h3>
          <p>제조번호가 아닌 ‘Model’ 또는 ‘모델명’ 항목을 확인합니다.</p>
        </article>
        <article class="step-card card">
          <h3>그대로 검색</h3>
          <p>공백과 하이픈은 달라도 괜찮지만 영문·숫자는 모두 입력하세요.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="verification-panel">
        <div>
          <div class="eyebrow">데이터 검증 방식</div>
          <h2>페이지 수보다 정보의 정확성을 우선합니다</h2>
          <p>
            제조사 공식 자료를 가장 먼저 확인하고, 모델 존재 여부와 소모품 호환 여부를 분리해
            표시합니다. 호환 근거가 없는 모델에는 구매 링크를 연결하지 않습니다.
          </p>
          <a class="button button-primary" href="/methodology">검증 기준 자세히 보기</a>
        </div>
        <ol class="verification-list">
          <li><strong>1</strong> 제조사 공식 설명서</li>
          <li><strong>2</strong> 제조사 공식 지원 페이지</li>
          <li><strong>3</strong> 제조사 공식 판매 페이지</li>
          <li><strong>4</strong> 판매자 정보와 사용자 제보</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">최근 추가</div>
          <h2>새로 등록된 공식 모델</h2>
        </div>
      </div>
      <div class="model-grid">
        {recentModels.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice-card">
        <span aria-hidden="true">ⓘ</span>
        <div>
          <strong>구매 링크는 정보 확인 뒤에 제공합니다.</strong>
          <p>
            모델핏은 상품을 직접 판매하지 않습니다. 제휴 링크를 사용할 때는 판매 페이지의 모델 호환
            범위를 다시 확인하세요.
          </p>
          <AffiliateDisclosure />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
