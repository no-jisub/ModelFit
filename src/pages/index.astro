---
import BrandCard from "@/components/astro/BrandCard.astro";
import CategorySelector from "@/components/astro/CategorySelector.astro";
import CoupangCategoryBanner from "@/components/astro/CoupangCategoryBanner.astro";
import { brands } from "@/data/brands";
import { consumables } from "@/data/consumables";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featuredBrandIds = ["samsung", "lg", "roborock", "dreame", "coway", "xiaomi"];
const featuredBrands = featuredBrandIds
  .map((id) => brands.find((brand) => brand.id === id))
  .filter((brand) => brand !== undefined);
const otherBrands = brands.filter((brand) => !featuredBrandIds.includes(brand.id));
const websiteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "모델핏",
    url: Astro.site,
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site}find?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "모델핏",
    url: Astro.site,
  },
];
---

<BaseLayout
  title="가전 모델명으로 호환 소모품 찾기"
  description="공기청정기와 로봇청소기 모델명을 검색해 필터, 브러시, 먼지봉투 등 호환 소모품 정보를 확인하세요."
  canonicalPath="/"
  jsonLd={websiteJsonLd}
>
  <section class="section home-category-section">
    <div class="container home-category-inner">
      <div class="home-category-heading">
        <h1>모델번호로 호환 소모품 찾기</h1>
      </div>
      <CategorySelector />
      <div class="home-category-meta" aria-label="모델핏 데이터 현황">
        <a href="/guide/find-model-number">모델번호 찾는 방법 →</a>
        <span>{models.length}개 공식 모델 · {consumables.length}개 소모품</span>
        <a href="/methodology">검증 기준 보기 →</a>
      </div>
    </div>
  </section>

  <CoupangCategoryBanner />

  <section class="section home-section-tint" id="brands">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">인기 브랜드</div>
          <h2>브랜드별로 모델 찾기</h2>
        </div>
      </div>
      <div class="brand-grid">
        {featuredBrands.map((brand) => <BrandCard brand={brand} />)}
      </div>
      <details class="brand-directory">
        <summary>
          <span class="brand-directory-expand">
            {brands.length}개 브랜드 전체 보기 <span aria-hidden="true">↓</span>
          </span>
          <span class="brand-directory-collapse">
            브랜드 목록 닫기 <span aria-hidden="true">↑</span>
          </span>
        </summary>
        <div class="brand-grid brand-grid-secondary">
          {otherBrands.map((brand) => <BrandCard brand={brand} />)}
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
