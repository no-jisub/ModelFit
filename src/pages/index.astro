---
import BrandCard from "@/components/astro/BrandCard.astro";
import CategorySelector from "@/components/astro/CategorySelector.astro";
import ModelCard from "@/components/astro/ModelCard.astro";
import SearchBox from "@/components/react/SearchBox";
import { brands } from "@/data/brands";
import { consumables } from "@/data/consumables";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";

const popularModels = [
  "samsung-ap90h10198edd",
  "lg-as355nsna",
  "roborock-saros-z70",
  "dreame-x50s-pro-ultra",
]
  .map((id) => models.find((model) => model.id === id))
  .filter((model) => model !== undefined);
const featuredBrandIds = ["samsung", "lg", "roborock", "dreame", "coway", "xiaomi"];
const featuredBrands = featuredBrandIds
  .map((id) => brands.find((brand) => brand.id === id))
  .filter((brand) => brand !== undefined);
const otherBrands = brands.filter((brand) => !featuredBrandIds.includes(brand.id));
const websiteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "모델핏",
    url: Astro.site,
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site}find?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "모델핏",
    url: Astro.site,
  },
];
---

<BaseLayout
  title="가전 모델명으로 호환 소모품 찾기"
  description="공기청정기와 로봇청소기 모델명을 검색해 필터, 브러시, 먼지봉투 등 호환 소모품 정보를 확인하세요."
  canonicalPath="/"
  jsonLd={websiteJsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <h1>모델명이나 부품번호로<br />맞는 소모품을 찾아보세요</h1>
      <p class="hero-description">
        제조사 공식 자료를 바탕으로 호환 범위와 검증 상태,<br />
        마지막 확인일까지 한눈에 정리합니다.
      </p>
      <SearchBox client:load />
      <div class="hero-trust" aria-label="모델핏 데이터 현황">
        <span><strong>{models.length}</strong>개 공식 모델</span>
        <span><strong>{consumables.length}</strong>개 소모품</span>
        <a href="/methodology">공식 출처 기반 검증 →</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">지원 카테고리</div>
          <h2>어떤 제품을 찾고 계신가요?</h2>
        </div>
      </div>
      <CategorySelector />
    </div>
  </section>

  <section class="section home-verification-section">
    <div class="container">
      <div class="verification-panel home-verification">
        <div>
          <div class="eyebrow">데이터 검증 방식</div>
          <h2>호환 정보의 근거까지 확인합니다</h2>
          <p>
            모델 존재 여부와 소모품 호환 여부를 따로 검증하고, 확인한 출처와 날짜를 함께 공개합니다.
          </p>
          <a class="button button-primary" href="/methodology">검증 기준 자세히 보기</a>
        </div>
        <ol class="verification-list">
          <li><strong>1</strong> 모델 정보를 공식 자료로 확인</li>
          <li><strong>2</strong> 소모품 호환 관계를 별도 검증</li>
          <li><strong>3</strong> 출처와 마지막 확인일 공개</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section home-section-tint" id="brands">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">인기 브랜드</div>
          <h2>브랜드별로 모델 찾기</h2>
        </div>
      </div>
      <div class="brand-grid">
        {featuredBrands.map((brand) => <BrandCard brand={brand} />)}
      </div>
      <details class="brand-directory">
        <summary>{brands.length}개 브랜드 전체 보기 <span aria-hidden="true">→</span></summary>
        <div class="brand-grid brand-grid-secondary">
          {otherBrands.map((brand) => <BrandCard brand={brand} />)}
        </div>
      </details>
    </div>
  </section>

  <section class="section home-models">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">빠르게 찾기</div>
          <h2>추천 공식 모델</h2>
        </div>
        <a class="text-link" href="/find">전체 모델 보기 →</a>
      </div>
      <div class="model-grid">
        {popularModels.map((model) => <ModelCard model={model} />)}
      </div>
    </div>
  </section>

  <section class="section home-section-tint">
    <div class="container">
      <div class="section-header">
        <div>
          <div class="eyebrow">모델명 찾기</div>
          <h2>정확한 모델 코드를 입력하세요</h2>
          <p>제품군 이름보다 영문과 숫자가 포함된 모델 코드가 정확합니다.</p>
        </div>
        <a class="text-link" href="/guide/find-model-number">자세한 가이드 →</a>
      </div>
      <div class="info-steps">
        <article class="step-card card">
          <h3>정격 라벨 확인</h3>
          <p>제품 뒷면, 바닥면 또는 필터 덮개 안쪽의 라벨을 찾습니다.</p>
        </article>
        <article class="step-card card">
          <h3>모델명 구분</h3>
          <p>제조번호가 아닌 ‘Model’ 또는 ‘모델명’ 항목을 확인합니다.</p>
        </article>
        <article class="step-card card">
          <h3>그대로 검색</h3>
          <p>공백과 하이픈은 달라도 괜찮지만 영문·숫자는 모두 입력하세요.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
