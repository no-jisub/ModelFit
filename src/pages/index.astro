---
import BrandCard from "@/components/astro/BrandCard.astro";
import CategorySelector from "@/components/astro/CategorySelector.astro";
import CoupangCategoryBanner from "@/components/astro/CoupangCategoryBanner.astro";
import { brands } from "@/data/brands";
import BaseLayout from "@/layouts/BaseLayout.astro";

const featuredBrandIds = [
  "samsung",
  "lg",
  "coway",
  "winix",
  "dyson",
  "roborock",
  "dreame",
  "xiaomi",
  "ecovacs",
  "irobot",
];
const featuredBrands = featuredBrandIds
  .map((id) => brands.find((brand) => brand.id === id))
  .filter((brand) => brand !== undefined);
const otherBrands = brands.filter((brand) => !featuredBrandIds.includes(brand.id));
const websiteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "모델핏",
    url: Astro.site,
    potentialAction: {
      "@type": "SearchAction",
      target: `${Astro.site}find?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "모델핏",
    url: Astro.site,
  },
];
---

<BaseLayout
  title="가전 모델명으로 호환 소모품 찾기"
  description="공기청정기와 로봇청소기 모델명을 검색해 필터, 브러시, 먼지봉투 등 호환 소모품 정보를 확인하세요."
  canonicalPath="/"
  jsonLd={websiteJsonLd}
>
  <section class="section home-category-section">
    <div class="container home-category-inner">
      <div class="home-category-heading">
        <h1>모델번호로 호환 소모품 찾기</h1>
      </div>
      <div class="home-discovery" data-home-discovery>
        <div class="home-discovery-tabs" role="tablist" aria-label="찾기 방식 선택">
          <button
            id="product-discovery-tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="product-discovery-panel"
            data-discovery-tab="product">제품으로 찾기</button
          >
          <button
            id="brand-discovery-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="brands"
            tabindex="-1"
            data-discovery-tab="brand">브랜드로 찾기</button
          >
        </div>
        <section
          id="product-discovery-panel"
          role="tabpanel"
          aria-labelledby="product-discovery-tab"
          data-discovery-panel="product"
        >
          <CategorySelector />
        </section>
        <section
          id="brands"
          role="tabpanel"
          aria-labelledby="brand-discovery-tab"
          data-discovery-panel="brand"
          hidden
        >
          <p class="category-selector-title">찾고 싶은 브랜드를 선택해 보세요</p>
          <div class="brand-grid">
            {featuredBrands.map((brand) => <BrandCard brand={brand} />)}
          </div>
          <details class="brand-directory">
            <summary>
              <span class="brand-directory-expand">
                {brands.length}개 브랜드 전체 보기 <span aria-hidden="true">↓</span>
              </span>
              <span class="brand-directory-collapse">
                브랜드 목록 닫기 <span aria-hidden="true">↑</span>
              </span>
            </summary>
            <div class="brand-grid brand-grid-secondary">
              {otherBrands.map((brand) => <BrandCard brand={brand} />)}
            </div>
          </details>
        </section>
      </div>
    </div>
  </section>

  <CoupangCategoryBanner />
</BaseLayout>

<script>
  const discovery = document.querySelector<HTMLElement>("[data-home-discovery]");

  if (discovery) {
    const tabs = [...discovery.querySelectorAll<HTMLButtonElement>("[data-discovery-tab]")];
    const panels = [...discovery.querySelectorAll<HTMLElement>("[data-discovery-panel]")];

    const activateTab = (nextTab: HTMLButtonElement, focus = false) => {
      const target = nextTab.dataset.discoveryTab;
      tabs.forEach((tab) => {
        const active = tab === nextTab;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.discoveryPanel !== target;
      });
      if (focus) nextTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const offset = event.key === "ArrowRight" ? 1 : -1;
        activateTab(tabs[(index + offset + tabs.length) % tabs.length], true);
      });
    });

    if (window.location.hash === "#brands") {
      const brandTab = tabs.find((tab) => tab.dataset.discoveryTab === "brand");
      if (brandTab) activateTab(brandTab);
    }
  }
</script>
