---
import SearchResults from "@/components/react/SearchResults";
import BaseLayout from "@/layouts/BaseLayout.astro";

const query = Astro.url.searchParams.get("q") ?? "";
---

<BaseLayout
  title="모델·소모품 통합 검색"
  description="브랜드, 모델명, 상품명, 정품 부품번호로 가전제품과 호환 소모품을 검색하세요."
  canonicalPath="/find"
  noindex
>
  <header class="page-heading">
    <div class="container content-narrow">
      <h1>모델·소모품 검색</h1>
    </div>
  </header>
  <div class="container search-page-shell">
    <SearchResults initialQuery={query} client:load />
  </div>
</BaseLayout>
