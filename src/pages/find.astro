---
import SearchResults from "@/components/react/SearchResults";
import BaseLayout from "@/layouts/BaseLayout.astro";

const query = Astro.url.searchParams.get("q") ?? "";
---

<BaseLayout
  title="모델·소모품 통합 검색"
  description="브랜드, 모델명, 상품명, 정품 부품번호로 가전제품과 호환 소모품을 검색하세요."
  canonicalPath="/find"
  noindex
>
  <section class="page-hero">
    <div class="container">
      <div class="content-narrow">
        <div class="eyebrow">통합 검색</div>
        <h1>모델과 소모품 한 번에 찾기</h1>
        <p>모델명·상품명·정품 부품번호로 검색하면 연결된 호환 관계까지 보여드립니다.</p>
      </div>
    </div>
  </section>
  <div class="container search-page-shell">
    <SearchResults initialQuery={query} client:load />
  </div>
</BaseLayout>
