---
import SearchBox from "@/components/react/SearchBox";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지가 없거나 이동되었습니다."
  noindex
>
  <section class="section">
    <div class="container content-narrow">
      <div class="empty-state card">
        <span class="empty-icon" aria-hidden="true">404</span><h1>페이지를 찾을 수 없습니다</h1><p>
          주소가 정확한지 확인하거나 아래 검색창에서 제품 모델을 찾아보세요.
        </p><SearchBox compact client:load /><div class="button-row" style="margin-top: 24px;">
          <a class="button button-primary" href="/">홈으로 이동</a><a
            class="button button-secondary"
            href="/#brands">인기 브랜드 보기</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
