---
import BrandCard from "@/components/astro/BrandCard.astro";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import ModelCard from "@/components/astro/ModelCard.astro";
import ModelGroupCard from "@/components/astro/ModelGroupCard.astro";
import { brands } from "@/data/brands";
import { guides } from "@/data/guides";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { ApplianceCategory } from "@/types";
import { categoryLabels } from "@/utils/labels";
import { groupModelsByName } from "@/utils/modelGroups";

export function getStaticPaths() {
  return (["air-purifier", "robot-vacuum"] satisfies ApplianceCategory[]).map((category) => ({
    params: { category },
  }));
}

const category = Astro.params.category as ApplianceCategory;
const label = categoryLabels[category];
const categoryModels = models.filter((model) => model.category === category);
const categoryModelGroups = groupModelsByName(categoryModels);
const categoryBrands = brands.filter((brand) => brand.supportedCategories.includes(category));
const relatedGuides = guides.filter(
  (guide) =>
    guide.category === (category === "air-purifier" ? "공기청정기" : "로봇청소기") ||
    guide.category === "기초",
);
const partTypes =
  category === "air-purifier"
    ? (["hepa-filter", "deodorizing-filter", "pre-filter", "all-in-one-filter"] as const)
    : (["dust-bin-filter", "dust-bag", "main-brush", "side-brush", "mop-pad"] as const);
---

<BaseLayout
  title={`${label} 호환 소모품 모델 목록`}
  description={`${label} 모델별 호환 소모품 정보를 찾고 필터, 브러시, 먼지봉투 등의 검증 상태를 확인하세요.`}
  canonicalPath={`/category/${category}`}
>
  <section class="page-hero category-page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label }]} />

      <h1>{label} 소모품 찾기</h1>
      <p>모델 코드를 선택해 공식 확인된 호환 소모품을 확인하세요.</p>
      <div class="stats-row">
        <div class="stat-card card">
          <strong>{categoryModels.filter((model) => !model.isDemo).length}</strong><span
            >공식 모델</span
          >
        </div>
        <div class="stat-card card">
          <strong>{categoryBrands.length}</strong><span>지원 브랜드</span>
        </div>
        <div class="stat-card card">
          <strong>{partTypes.length}</strong><span>소모품 유형</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section category-models-section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>{label} 등록 모델</h2><p>같은 제품명은 하나로 묶어 표시합니다.</p>
        </div>
      </div>
      <details class="category-model-filter" open data-category-model-filter>
        <summary>
          <span>필터</span>
          <span data-filter-summary>전체 {categoryModels.length}개</span>
        </summary>
        <div class="category-filter-content">
          <label class="category-filter-search">
            <span>모델번호</span>
            <input
              type="search"
              placeholder="모델번호 검색"
              autocomplete="off"
              data-model-filter-query
            />
          </label>
          <div
            class="category-filter-group category-filter-brands"
            role="group"
            aria-labelledby="category-brand-filter-label"
          >
            <span id="category-brand-filter-label" class="category-filter-label">브랜드</span>
            <div class="category-filter-chips">
              <button type="button" class="is-active" aria-pressed="true" data-filter-brand="all">
                전체
              </button>
              {
                categoryBrands.map((brand) => (
                  <button type="button" aria-pressed="false" data-filter-brand={brand.id}>
                    {brand.name}
                  </button>
                ))
              }
            </div>
          </div>
          <p class="category-filter-result" role="status" aria-live="polite" data-filter-result>
            {categoryModels.length}개 모델
          </p>
        </div>
      </details>
      <div class="model-grid" data-filter-model-grid>
        {
          categoryModelGroups.map(({ models: groupedModels }) => {
            const representative = groupedModels[0];
            if (!representative) return null;
            const searchText = groupedModels
              .flatMap((item) => [
                item.brandName,
                item.brandNameEn,
                item.modelName,
                item.modelCode,
                item.series,
                ...item.aliases,
              ])
              .filter(Boolean)
              .join(" ");

            return (
              <div
                class="category-model-filter-item"
                data-brand-id={representative.brandId}
                data-model-count={groupedModels.length}
                data-search-text={searchText}
              >
                {groupedModels.length > 1 ? (
                  <ModelGroupCard models={groupedModels} />
                ) : (
                  <ModelCard model={representative} />
                )}
              </div>
            );
          })
        }
      </div>
      <div class="empty-state card category-filter-empty" hidden data-filter-empty>
        <span class="empty-icon" aria-hidden="true">⌕</span>
        <h2>조건에 맞는 모델이 없습니다</h2>
        <p>브랜드나 모델번호 조건을 바꿔 다시 확인해 보세요.</p>
      </div>
    </div>
  </section>
  <section class="section category-brands-section">
    <div class="container">
      <div class="section-header">
        <div><h2>{label} 지원 브랜드</h2></div>
      </div>
      <div class="brand-grid">
        {categoryBrands.map((brand) => <BrandCard brand={brand} />)}
      </div>
    </div>
  </section>

  <section class="section category-guides-section">
    <div class="container">
      <div class="section-header">
        <div><h2>구매 전 확인할 내용</h2></div>
      </div>
      <div class="related-grid">
        {
          relatedGuides.slice(0, 3).map((guide) => (
            <a class="related-card card interactive-card" href={`/guide/${guide.slug}`}>
              <>
                <h3>{guide.title}</h3>
                <p>{guide.summary}</p>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const normalizeFilterText = (value: string) => value.toLowerCase().replace(/[\s-]/g, "");

  document.querySelectorAll<HTMLElement>("[data-category-model-filter]").forEach((filter) => {
    const grid = filter.parentElement?.querySelector<HTMLElement>("[data-filter-model-grid]");
    const items = Array.from(
      grid?.querySelectorAll<HTMLElement>(".category-model-filter-item") ?? [],
    );
    const queryInput = filter.querySelector<HTMLInputElement>("[data-model-filter-query]");
    const result = filter.querySelector<HTMLElement>("[data-filter-result]");
    const summary = filter.querySelector<HTMLElement>("[data-filter-summary]");
    const empty = filter.parentElement?.querySelector<HTMLElement>("[data-filter-empty]");
    const mobileQuery = window.matchMedia("(max-width: 700px)");
    let selectedBrand = "all";

    const updateDisclosure = () => {
      if (filter instanceof HTMLDetailsElement) filter.open = !mobileQuery.matches;
    };

    const updatePressed = (buttons: NodeListOf<HTMLButtonElement>, selectedValue: string) => {
      buttons.forEach((button) => {
        const value = button.dataset.filterBrand;
        const active = value === selectedValue;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
    };

    const applyFilters = () => {
      const query = normalizeFilterText(queryInput?.value ?? "");
      let visibleModelCount = 0;

      items.forEach((item) => {
        const matchesBrand = selectedBrand === "all" || item.dataset.brandId === selectedBrand;
        const matchesQuery = normalizeFilterText(item.dataset.searchText ?? "").includes(query);
        const visible = matchesBrand && matchesQuery;
        item.hidden = !visible;
        if (visible) visibleModelCount += Number(item.dataset.modelCount ?? 1);
      });

      const countText = `${visibleModelCount}개 모델`;
      if (result) result.textContent = countText;
      if (summary) summary.textContent = countText;
      if (empty) empty.hidden = visibleModelCount > 0;
    };

    const brandButtons = filter.querySelectorAll<HTMLButtonElement>("[data-filter-brand]");

    brandButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedBrand = button.dataset.filterBrand ?? "all";
        updatePressed(brandButtons, selectedBrand);
        applyFilters();
      });
    });

    queryInput?.addEventListener("input", applyFilters);
    mobileQuery.addEventListener("change", updateDisclosure);
    updateDisclosure();
    applyFilters();
  });
</script>
