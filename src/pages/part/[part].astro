---
import { consumables } from "@/data/consumables";
import { getConsumableModelPath } from "@/utils/consumableNavigation";

export function getStaticPaths() {
  return consumables.map((part) => ({ params: { part: part.slug }, props: { part } }));
}

const { part } = Astro.props;
const destination = getConsumableModelPath(part);
// Astro's type checker does not trace variable usage inside a top-level redirect return.
void destination;

return Astro.redirect(destination, 301);
---
