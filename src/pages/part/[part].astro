---
import { consumables } from "@/data/consumables";
import { getConsumableModelPath } from "@/utils/consumableNavigation";

export function getStaticPaths() {
  return consumables.map((part) => ({ params: { part: part.slug }, props: { part } }));
}

const { part } = Astro.props;

return Astro.redirect(getConsumableModelPath(part), 301);
---
