---
import ConsumableGroupPreview from "@/components/astro/ConsumableGroupPreview.astro";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { design: "consumables" } }] : [];
}

const variants = [
  {
    id: "rows",
    letter: "A",
    title: "유형별 상품 목록",
    tag: "추천",
    description: "유형과 설명은 한 번만 보여주고, 아래에서 상품과 가격을 나란히 비교합니다.",
  },
  {
    id: "tiles",
    letter: "B",
    title: "유형별 상품 카드",
    tag: "상품 강조",
    description: "소모품 유형 안에 상품 카드 3개를 배치합니다. 상품별 차이를 더 설명하기 좋습니다.",
  },
  {
    id: "accordion",
    letter: "C",
    title: "유형별 펼침 목록",
    tag: "많은 유형에 적합",
    description: "필요한 소모품 유형만 펼쳐서 봅니다. 유형이 많을 때 페이지를 짧게 유지합니다.",
  },
] as const;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>소모품 유형별 상품 구조 예시 · 모델핏</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">✓ <span>모델핏</span></a><a href="/preview/part-cards"
        >이전 카드 예시 ↗</a
      >
    </header>
    <main>
      <div class="intro">
        <span class="eyebrow">CONSUMABLE GROUPS</span><h1>
          유형별로 찾고,<br />상품을 비교하세요.
        </h1><p>모델 1 → 소모품 유형과 설명 → 상품 1·2·3</p><p class="note">
          구조 비교용 화면입니다. 모델·상품·가격·판매 구성은 모두 가상 예시입니다.
        </p>
      </div>
      <div class="controls">
        <nav aria-label="구조 예시">
          {
            variants.map((v) => (
              <a href={`#group-design-${v.id}`}>
                {v.letter} {v.title.replace("유형별 ", "")}
              </a>
            ))
          }
        </nav><div class="width-toggle" role="group" aria-label="화면 너비">
          <button type="button" data-width="wide" aria-pressed="true">넓게 보기</button><button
            type="button"
            data-width="mobile"
            aria-pressed="false">모바일 보기</button
          >
        </div>
      </div>
      {
        variants.map((v) => (
          <section class="variant" id={`group-design-${v.id}`} aria-labelledby={`heading-${v.id}`}>
            <>
              <div class="variant-heading">
                <>
                  <span class="letter">{v.letter}</span>
                  <div>
                    <>
                      <h2 id={`heading-${v.id}`}>
                        {v.title}
                        <span class:list={["tag", v.id === "rows" && "recommended"]}>{v.tag}</span>
                      </h2>
                      <p>{v.description}</p>
                    </>
                  </div>
                </>
              </div>
              <div class="preview-frame">
                <ConsumableGroupPreview variant={v.id} prefix={v.id} />
              </div>
            </>
          </section>
        ))
      }
      <aside>
        <strong>추천은 A안입니다.</strong><p>
          사용자는 필요한 소모품을 먼저 찾고, 같은 유형 안에서 정품·호환 상품과 판매 구성을 비교할
          수 있습니다. 소모품 유형이 많아지면 C안의 접기 기능을 더하면 좋겠습니다.
        </p>
      </aside>
      <p id="group-preview-status" role="status" aria-live="polite"></p>
    </main>
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-width]").forEach((button) =>
        button.addEventListener("click", () => {
          document.body.classList.toggle("mobile-preview", button.dataset.width === "mobile");
          document
            .querySelectorAll<HTMLButtonElement>("[data-width]")
            .forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        }),
      );
      document.querySelectorAll<HTMLButtonElement>(".purchase").forEach((button) =>
        button.addEventListener("click", () => {
          const status = document.querySelector<HTMLElement>("#group-preview-status");
          if (status) status.textContent = "디자인 예시입니다. 실제 상품 구매로 연결되지 않습니다.";
        }),
      );
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
    background: #f5f7fb;
  }
  :global(body) {
    margin: 0;
    color: #15243d;
    font-family:
      Pretendard,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      "Malgun Gothic",
      sans-serif;
    word-break: keep-all;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(button) {
    font: inherit;
    cursor: pointer;
  }
  :global(button:focus-visible),
  :global(a:focus-visible),
  :global(summary:focus-visible) {
    outline: 3px solid #99b6ff;
    outline-offset: 4px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    border-bottom: 1px solid #e1e8f2;
    padding: 20px max(24px, calc((100vw - 1040px) / 2));
  }
  header > a:last-child {
    font-size: 12px;
    color: #6f8096;
  }
  .brand {
    color: #2450df;
    font-size: 23px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand span {
    font-size: 18px;
    color: #15243d;
  }
  main {
    max-width: 1040px;
    padding: 40px 24px 64px;
    margin: auto;
  }
  .eyebrow {
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 2px;
    color: #4765ac;
  }
  h1 {
    margin: 12px 0 18px;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.35;
    letter-spacing: -1.2px;
  }
  .intro p {
    margin: 0;
    color: #698099;
    font-size: 14px;
    line-height: 1.7;
  }
  .intro .note {
    margin-top: 10px;
    color: #8391a6;
    font-size: 11px;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin: 28px 0 36px;
  }
  nav {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  nav a {
    border: 1px solid #dce5f1;
    border-radius: 999px;
    padding: 10px 14px;
    background: #fff;
    font-size: 12px;
    font-weight: 600;
  }
  .width-toggle {
    display: flex;
    padding: 4px;
    border-radius: 9px;
    background: #e9edf4;
  }
  .width-toggle button {
    background: transparent;
    border: 0;
    border-radius: 6px;
    padding: 8px 12px;
    color: #6d7b91;
    font-size: 11px;
  }
  .width-toggle button[aria-pressed="true"] {
    background: white;
    color: #2450df;
    box-shadow: 0 1px 4px #1b294411;
  }
  .variant {
    margin-bottom: 42px;
    scroll-margin-top: 20px;
  }
  .variant-heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }
  .letter {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border: 1px solid #dce5f1;
    border-radius: 9px;
    background: #fff;
    font-size: 13px;
    font-weight: 750;
  }
  h2 {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 18px;
  }
  .tag {
    padding: 4px 7px;
    border-radius: 5px;
    font-size: 10px;
    background: #e8edf5;
    color: #627690;
  }
  .recommended {
    background: #e8efff;
    color: #2856d5;
  }
  .variant-heading p {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: #6b7d94;
  }
  .preview-frame {
    width: 100%;
    max-width: 100%;
    margin: auto;
    container-type: inline-size;
    container-name: group-preview;
  }
  :global(.mobile-preview) .preview-frame {
    width: 390px;
  }
  aside {
    padding: 24px;
    border-radius: 14px;
    background: #eaf0ff;
    color: #456499;
  }
  aside strong {
    font-size: 14px;
    color: #294e99;
  }
  aside p {
    margin: 10px 0 0;
    font-size: 12px;
    line-height: 1.8;
  }
  #group-preview-status:not(:empty) {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 14px 18px;
    border-radius: 10px;
    background: #15243d;
    color: white;
    font-size: 12px;
    box-shadow: 0 6px 20px #15243d33;
    line-height: 1.5;
    z-index: 10;
  }
  @media (max-width: 600px) {
    header {
      padding: 16px;
    }
    main {
      padding: 30px 16px 40px;
    }
    .width-toggle {
      width: 100%;
    }
    .width-toggle button {
      flex: 1;
    }
    nav a {
      padding: 9px 10px;
      font-size: 11px;
    }
  }
</style>
