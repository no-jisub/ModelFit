---
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import { guides } from "@/data/guides";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="소모품 선택 가이드"
  description="모델명 찾기부터 정품과 호환품 비교, 필터와 브러시 교체주기까지 구매 전 확인 가이드를 제공합니다."
  canonicalPath="/guide"
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "가이드" }]} />
      <div class="eyebrow">구매 전 도움말</div>
      <h1>소모품을 고르기 전에 확인하세요</h1>
      <p>짧은 설명보다 실제 확인 순서와 체크리스트 중심으로 정리했습니다.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="related-grid">
        {
          guides.map((guide) => (
            <a class="related-card card interactive-card" href={`/guide/${guide.slug}`}>
              <>
                <span class="category-chip">{guide.category}</span>
                <h2 style="font-size: 20px; margin-top: 16px;">{guide.title}</h2>
                <p>{guide.summary}</p>
                <span class="text-link">가이드 읽기 →</span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
