---
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import ModelCard from "@/components/astro/ModelCard.astro";
import ModelGroupCard from "@/components/astro/ModelGroupCard.astro";
import { brands } from "@/data/brands";
import { guides } from "@/data/guides";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLabels } from "@/utils/labels";
import { groupModelsByName } from "@/utils/modelGroups";

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props;
const brandModels = models.filter((model) => model.brandId === brand.id);
const brandModelGroups = groupModelsByName(brandModels);
const officialModels = brandModels.filter((model) => !model.isDemo);
---

<BaseLayout
  title={`${brand.name} 호환 소모품 모델 찾기`}
  description={`${brand.name} ${brand.nameEn ?? ""} 공기청정기와 로봇청소기 모델별 소모품 정보를 찾아보세요.`}
  canonicalPath={`/brand/${brand.slug}`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: "브랜드", href: "/#brands" }, { label: brand.name }]} />
      <h1>{brand.name} <span class="model-code">{brand.nameEn}</span></h1>
      <p class="page-meta-inline">
        {brand.supportedCategories.map((category) => categoryLabels[category]).join(" · ")} · {
          officialModels.length
        }개 모델
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>등록 모델</h2>
        </div>
      </div>
      <div class="model-grid">
        {
          brandModelGroups.map(({ models: groupedModels }) =>
            groupedModels.length > 1 ? (
              <ModelGroupCard models={groupedModels} />
            ) : (
              groupedModels[0] && <ModelCard model={groupedModels[0]} />
            ),
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div><h2>모델 확인 가이드</h2></div>
      </div>
      <div class="related-grid">
        {
          guides.slice(0, 3).map((guide) => (
            <a class="related-card card interactive-card" href={`/guide/${guide.slug}`}>
              <>
                <h3>{guide.title}</h3>
                <p>{guide.summary}</p>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
