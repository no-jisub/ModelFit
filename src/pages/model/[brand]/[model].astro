---
import "@/styles/model-detail.css";
import Breadcrumbs from "@/components/astro/Breadcrumbs.astro";
import MobilePartsJump from "@/components/astro/MobilePartsJump.astro";
import ConsumableCard from "@/components/astro/ConsumableCard.astro";
import PurchaseBundleList from "@/components/astro/PurchaseBundleList.astro";
import ModelPhoto from "@/components/astro/ModelPhoto.astro";
import AffiliateDisclosure from "@/components/astro/AffiliateDisclosure.astro";
import { canDisplayModelImage } from "@/utils/modelImage";
import SourceList from "@/components/astro/SourceList.astro";

import { consumables } from "@/data/consumables";
import { models } from "@/data/models";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryLabels, partTypeLabels } from "@/utils/labels";
import { getModelFullName } from "@/utils/modelDisplayName";
import { groupModelConsumables } from "@/utils/groupModelConsumables";

export function getStaticPaths() {
  return models.map((model) => ({
    params: { brand: model.brandId, model: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;
const modelParts = model.consumableIds
  .map((id: string) => consumables.find((part) => part.id === id))
  .filter((part) => part !== undefined);
const parts = groupModelConsumables(modelParts);
const categoryLabel = categoryLabels[model.category];
const fullModelName = getModelFullName(model);
const title = `${fullModelName} 호환 소모품 찾기`;
const description =
  model.status !== "published"
    ? `${model.brandName} ${model.modelCode}에 맞는 필터, 브러시, 먼지봉투 등 호환 소모품 정보를 확인하세요. 현재 내용은 미검증 데모 데이터입니다.`
    : `${model.brandName} ${model.modelCode}의 제조사 공식 모델 출처와 소모품 호환 정보 등록 상태를 확인하세요.`;
const reportParams = new URLSearchParams({
  brand: model.brandName,
  model: model.modelCode,
  page: `/model/${model.brandId}/${model.slug}`,
});
const reportUrl = `/report?${reportParams.toString()}`;
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "홈", item: Astro.site },
    {
      "@type": "ListItem",
      position: 2,
      name: categoryLabel,
      item: new URL(`/category/${model.category}`, Astro.site),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${model.brandName} ${model.modelCode}`,
      item: Astro.url,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/model/${model.brandId}/${model.slug}`}
  jsonLd={breadcrumbJsonLd}
  analyticsEntityType="model"
  analyticsEntityId={model.id}
>
  <section class="model-detail-hero">
    <div class="container model-content">
      <Breadcrumbs
        items={[
          { label: categoryLabel, href: `/category/${model.category}` },
          { label: model.brandName, href: `/brand/${model.brandId}` },
        ]}
      />
      <div class="model-title-line">
        <div class="model-identity">
          <p class="model-brand-category">{model.brandName} · {categoryLabel}</p>
          <h1>{fullModelName}</h1>
          <div class="model-code-block">
            <span>모델 번호</span>
            <strong class="model-code">{model.modelCode}</strong>
          </div>
          <div class="model-identity-meta">
            <a href="#model-number-guide">모델번호 확인 방법</a>
          </div>
        </div>
        {
          model.image && (
            <figure class="model-detail-image">
              <div class="model-photo-surface">
                <ModelPhoto image={model.image} modelCode={model.modelCode} loading="eager" />
              </div>
              {canDisplayModelImage(model.image.src) && (
                <figcaption>
                  <a
                    href={model.image.sourceUrl}
                    target="_blank"
                    rel={
                      model.image.sourceUrl.startsWith("https://link.coupang.com/")
                        ? "sponsored noopener noreferrer"
                        : "noopener noreferrer"
                    }
                  >
                    {model.image.sourceUrl.startsWith("https://link.coupang.com/")
                      ? "쿠팡 상품 이미지 · 제휴 링크"
                      : "제품 이미지 출처"}
                  </a>
                </figcaption>
              )}
            </figure>
          )
        }
      </div>

      {
        model.image?.sourceUrl.startsWith("https://link.coupang.com/") && (
          <AffiliateDisclosure hasAffiliateLinks />
        )
      }

      {
        model.status !== "published" && (
          <div class="alert-box" role="alert">
            <div>
              <h2>이 정보는 공식 자료로 확인되지 않은 데모 데이터입니다.</h2>
              <p>실제 구매 전 반드시 제조사 또는 판매자에게 모델별 호환 여부를 확인하세요.</p>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <div class="container model-content">
    <section class="detail-section compatible-parts-section" id="compatible-parts">
      <div class="section-header compatible-parts-header">
        <div>
          <div class="section-title-row">
            <h2>호환 소모품·부품</h2>
            {parts.length > 0 && <span class="section-count">등록 {parts.length}개</span>}
          </div>
        </div>
      </div>
      {
        parts.length >= 4 && (
          <nav class="consumable-jump-links" aria-label="소모품 바로가기">
            {parts.map((part) => (
              <a href={`#${part.id}`} aria-label={`${part.displayName}으로 이동`}>
                <span>
                  <strong>{partTypeLabels[part.type]}</strong>
                  <small>{part.displayName}</small>
                </span>
              </a>
            ))}
          </nav>
        )
      }
      <div class="consumable-list">
        {
          parts.length > 0 ? (
            parts.map((part) => (
              <ConsumableCard part={part} modelCode={model.modelCode} modelId={model.id} />
            ))
          ) : (
            <div class="empty-state card">
              <span class="empty-icon" aria-hidden="true">
                ⌕
              </span>
              <h2>확인된 부품 정보가 아직 없습니다</h2>
              <p>제조사 설명서나 공식 부품 페이지에서 이 모델의 호환 근거를 확인하고 있습니다.</p>
              <div class="button-row">
                <a class="button button-secondary" href={reportUrl}>
                  공식 자료 제보하기
                </a>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <PurchaseBundleList parts={parts} modelId={model.id} />
    <section class="detail-section model-reference-section" aria-label="모델 확인 자료">
      <div class="model-reference-grid">
        <details class="detail-disclosure">
          <summary>
            <strong>제조사 공식 출처</strong>
          </summary>
          <div class="detail-disclosure-content">
            <SourceList sources={model.sources} />
          </div>
        </details>
        <details class="detail-disclosure" id="model-number-guide">
          <summary>
            <strong>모델번호 확인 위치</strong>
          </summary>
          <div class="detail-disclosure-content">
            <div class="info-card card">
              <span class="info-icon" aria-hidden="true">i</span>
              <div>
                <h3>이 모델의 라벨 위치</h3>
                <p>
                  {"제품의 뒷면 또는 바닥면 정격 라벨을 확인하세요."}
                </p>
                <a class="text-link" href="/guide/find-model-number">모델번호 찾는 방법 보기 →</a>
              </div>
            </div>
          </div>
        </details>
      </div>
    </section>
    <section class="detail-section model-disclaimer-section">
      <div class="notice-card model-disclaimer">
        <span aria-hidden="true">!</span>
        <div>
          <strong>면책 안내</strong>
          <p>
            {
              model.status !== "published"
                ? "데모 페이지의 부품번호·규격·가격·재고는 구매 전 제조사에서 확인하세요."
                : "부품번호·규격·가격·재고는 구매 전 소모품 검증 상태와 판매 페이지에서 다시 확인하세요."
            }
          </p>
        </div>
      </div>
      <div class="model-report-link">
        <a class="text-link" href={reportUrl}>정보 수정 제보하기 →</a>
      </div>
    </section>
  </div>

  <MobilePartsJump />
</BaseLayout>

<style>
  #model-number-guide {
    scroll-margin-top: 140px;
  }
</style>

<script>
  const revealModelGuide = () => {
    if (window.location.hash !== "#model-number-guide") return;
    const guide = document.querySelector<HTMLDetailsElement>("#model-number-guide");
    if (guide) guide.open = true;
  };
  revealModelGuide();
  window.addEventListener("hashchange", revealModelGuide);
  document.querySelectorAll<HTMLAnchorElement>('a[href="#model-number-guide"]').forEach((link) => {
    link.addEventListener("click", () => {
      const guide = document.querySelector<HTMLDetailsElement>("#model-number-guide");
      if (guide) guide.open = true;
    });
  });
</script>
